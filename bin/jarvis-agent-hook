#!/usr/bin/env python3
"""Relay a coding agent's hook event (Claude Code, Codex) to JARVIS, so JARVIS can show what the agent is doing and,
when the person turned it on, answer its permission requests from the window (jarvis/hub/coding.py).

  jarvis-agent-hook [--agent claude|codex] [--account NAME]     (the hook's JSON on stdin)

It never gets in the agent's way: if JARVIS isn't running, the socket isn't ours, or nobody answers, it exits 0 and
prints nothing, and the agent carries on exactly as without JARVIS (for a permission request, its own prompt appears).
It prints a decision only when the person allowed or denied in JARVIS's window.

Standard library only (it starts on every hook event); talks only to the core's owner-only Unix socket.
"""
import json
import os
import socket
import stat
import sys

CONNECT_S = 0.3
PERMISSION_WAIT_S = 115.0
DROP = ("tool_response", "tool_output", "transcript_path", "agent_transcript_path")
MAX_STR = 2000


def clip(value, depth=0):
    if isinstance(value, str):
        return value if len(value) <= MAX_STR else value[: MAX_STR - 1] + "…"
    if isinstance(value, dict) and depth < 4:
        return {k: clip(v, depth + 1) for k, v in value.items() if k not in DROP}
    if isinstance(value, list) and depth < 4:
        return [clip(v, depth + 1) for v in value[:50]]
    return value if isinstance(value, (int, float, bool)) or value is None else str(value)[:MAX_STR]


def socket_path():
    if os.environ.get("JARVIS_HOOK_SOCKET"):
        return os.environ["JARVIS_HOOK_SOCKET"]
    run = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return os.path.join(run, "jarvis", "hooks.sock")


def arg(name, default=""):
    if name in sys.argv[1:]:
        i = sys.argv.index(name)
        return sys.argv[i + 1] if i + 1 < len(sys.argv) else default
    return default


def main():
    agent = arg("--agent", "claude")
    account = arg("--account", "")
    try:
        event = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return
    if not isinstance(event, dict):
        return
    path = socket_path()
    try:
        info = os.stat(os.path.dirname(path))
        # JARVIS's runtime folder is 0700 and ours; anything else is not our JARVIS.
        if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
            return
    except OSError:
        return
    blocking = event.get("hook_event_name") == "PermissionRequest"
    try:
        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        conn.settimeout(CONNECT_S)
        conn.connect(path)
        conn.sendall((json.dumps({"op": "agent_hook", "agent": agent, "account": account, "event": clip(event)},
                                 ensure_ascii=False) + "\n").encode())
        conn.settimeout(PERMISSION_WAIT_S if blocking else 2.0)
        data = b""
        while not data.endswith(b"\n"):
            chunk = conn.recv(65536)
            if not chunk:
                break
            data += chunk
        conn.close()
    except (OSError, ValueError):
        return
    if not blocking:
        return
    try:
        reply = json.loads(data.decode() or "{}")
    except ValueError:
        return
    decision = reply.get("decision")
    if decision not in ("allow", "deny"):
        return
    out = {"behavior": decision}
    if decision == "deny":
        out["message"] = reply.get("message") or "Запрещено в окне JARVIS."
    sys.stdout.write(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": out}},
                                ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except Exception:   # noqa: BLE001
        pass  # never break the agent
    sys.exit(0)
